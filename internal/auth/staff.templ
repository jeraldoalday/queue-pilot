package auth

import (
	"github.com/jeraldoalday/queuepilot/internal/db"
	"github.com/jeraldoalday/queuepilot/internal/db/sqlc"
	"github.com/jeraldoalday/queuepilot/internal/web/components"
)

templ StaffListPage(staff []sqlc.ListStaffUsersByOrgRow, csrfToken string) {
	@components.Layout("Staff") {
		<main class="mx-auto max-w-3xl px-6 py-16">
			<p class="mb-4"><a href="/app" class="text-sm text-slate-600 underline">&larr; Dashboard</a></p>
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-semibold tracking-tight">Staff</h1>
				<a href="/app/staff/new" class="text-sm font-medium text-slate-900 underline">Add a staff member</a>
			</div>
			@StaffTable(staff, csrfToken)
			<p class="mt-6 text-xs text-slate-500">
				Suspending an account signs it out everywhere and blocks it from
				signing back in. Nothing it did is removed: past appointments and
				the tickets it called stay on the record, which is why there is no
				delete here.
			</p>
		</main>
	}
}

// StaffTable is its own component because it is what the suspend and
// restore buttons swap in place — the page around it does not need to be
// re-rendered to change one row's state.
templ StaffTable(staff []sqlc.ListStaffUsersByOrgRow, csrfToken string) {
	<div id="staff-table">
		if len(staff) == 0 {
			<p class="mt-6 text-sm text-slate-500">No staff members yet.</p>
		}
		<table class="mt-6 w-full border-collapse text-sm">
			<tbody>
				for _, st := range staff {
					<tr class="border-b border-slate-100">
						<td class="py-2 pr-4 font-medium">
							{ st.Name }
							if st.DisabledAt.Valid {
								<span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Suspended</span>
							}
						</td>
						<td class="py-2 pr-4 text-slate-500">{ st.Email }</td>
						<td class="py-2 pr-4 text-right">
							<a href={ templ.SafeURL("/app/staff/" + db.UUIDString(st.ID) + "/availability") } class="text-slate-600 underline">
								Manage availability
							</a>
						</td>
						<td class="py-2 text-right">
							@staffAccessButton(st, csrfToken)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// staffAccessButton posts the state the account should end up in, not a
// toggle: a double-tapped button then leaves the account where the admin
// meant it to be rather than back where it started.
templ staffAccessButton(st sqlc.ListStaffUsersByOrgRow, csrfToken string) {
	<form
		hx-post={ "/app/staff/" + db.UUIDString(st.ID) + "/access" }
		hx-target="#staff-table"
		hx-swap="outerHTML"
		class="inline"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		if st.DisabledAt.Valid {
			<input type="hidden" name="disabled" value="false"/>
			<button type="submit" class="rounded-md border border-slate-300 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50">
				Restore access
			</button>
		} else {
			<input type="hidden" name="disabled" value="true"/>
			<button type="submit" class="rounded-md border border-amber-300 px-2 py-1 text-xs font-medium text-amber-800 hover:bg-amber-50">
				Suspend
			</button>
		}
	</form>
}

templ NewStaffPage(errMsg, csrfToken string) {
	@components.Layout("Add staff") {
		<main class="mx-auto max-w-sm px-6 py-16">
			<h1 class="text-2xl font-semibold tracking-tight">Add a staff member</h1>
			if errMsg != "" {
				<p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{ errMsg }</p>
			}
			<form method="POST" action="/app/staff" class="mt-6 space-y-4">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div>
					<label for="name" class="block text-sm font-medium text-slate-700">Name</label>
					<input id="name" name="name" type="text" required class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-slate-700">Email</label>
					<input id="email" name="email" type="email" required class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-slate-700">Temporary password</label>
					<input id="password" name="password" type="password" required minlength="8" class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
				</div>
				<button type="submit" class="w-full rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">
					Add staff member
				</button>
			</form>
			<p class="mt-4 text-xs text-slate-500">
				There's no self-service invite flow yet — share this password with them directly.
			</p>
		</main>
	}
}
