package catalog

import (
	"fmt"

	"github.com/jackc/pgx/v5/pgtype"

	"github.com/jeraldoalday/queuepilot/internal/db"
	"github.com/jeraldoalday/queuepilot/internal/db/sqlc"
	"github.com/jeraldoalday/queuepilot/internal/web/components"
)

templ ServicesPage(services []sqlc.Service, staff []sqlc.ListStaffUsersByOrgRow, assignments map[string]map[string]bool, errMsg, csrfToken string) {
	@components.Layout("Services") {
		<main class="mx-auto max-w-4xl px-6 py-16">
			<p class="mb-4"><a href="/app" class="text-sm text-slate-600 underline">&larr; Dashboard</a></p>
			@ServicesSection(services, staff, assignments, errMsg, csrfToken)
		</main>
	}
}

templ ServicesSection(services []sqlc.Service, staff []sqlc.ListStaffUsersByOrgRow, assignments map[string]map[string]bool, errMsg, csrfToken string) {
	<div id="services-app">
		<h1 class="text-2xl font-semibold tracking-tight">Services</h1>
		if errMsg != "" {
			<p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{ errMsg }</p>
		}
		<form hx-post="/app/services" hx-target="#services-app" hx-swap="outerHTML" class="mt-6 flex flex-wrap items-end gap-3 rounded-md border border-slate-200 bg-white p-4">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div>
				<label for="name" class="block text-xs font-medium text-slate-700">Name</label>
				<input id="name" name="name" type="text" required class="mt-1 rounded-md border border-slate-300 px-2 py-1.5 text-sm"/>
			</div>
			<div>
				<label for="description" class="block text-xs font-medium text-slate-700">Description</label>
				<input id="description" name="description" type="text" class="mt-1 rounded-md border border-slate-300 px-2 py-1.5 text-sm"/>
			</div>
			<div>
				<label for="duration_minutes" class="block text-xs font-medium text-slate-700">Duration (min)</label>
				<input id="duration_minutes" name="duration_minutes" type="number" min="1" required class="mt-1 w-24 rounded-md border border-slate-300 px-2 py-1.5 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">
				Add service
			</button>
		</form>

		<table class="mt-6 w-full border-collapse text-sm">
			<thead>
				<tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
					<th class="py-2 pr-4">Name</th>
					<th class="py-2 pr-4">Duration</th>
					<th class="py-2 pr-4">Status</th>
					<th class="py-2 pr-4">Staff</th>
					<th class="py-2"></th>
				</tr>
			</thead>
			<tbody id="services-table-body">
				for _, svc := range services {
					@ServiceRowView(svc, staff, assignments[db.UUIDString(svc.ID)], csrfToken)
				}
			</tbody>
		</table>
		if len(services) == 0 {
			<p class="mt-4 text-sm text-slate-500">No services yet — add one above.</p>
		}
	</div>
}

templ ServiceRowView(svc sqlc.Service, staff []sqlc.ListStaffUsersByOrgRow, assignedIDs map[string]bool, csrfToken string) {
	<tr id={ rowID(svc.ID) } class="border-b border-slate-100">
		<td class="py-2 pr-4 font-medium">{ svc.Name }</td>
		<td class="py-2 pr-4">{ fmt.Sprintf("%d min", svc.DurationMinutes) }</td>
		<td class="py-2 pr-4">
			if svc.Active {
				<span class="text-green-700">active</span>
			} else {
				<span class="text-slate-400">inactive</span>
			}
		</td>
		<td class="py-2 pr-4">
			if len(staff) == 0 {
				<span class="text-slate-400">no staff yet</span>
			}
			for _, st := range staff {
				<label class="mr-3 inline-flex items-center gap-1">
					<input
						type="checkbox"
						checked?={ assignedIDs[db.UUIDString(st.ID)] }
						hx-post={ fmt.Sprintf("/app/services/%s/staff/%s/toggle", db.UUIDString(svc.ID), db.UUIDString(st.ID)) }
						hx-vals={ fmt.Sprintf(`{"csrf_token":"%s"}`, csrfToken) }
						hx-target={ "#" + rowID(svc.ID) }
						hx-swap="outerHTML"
					/>
					{ st.Name }
				</label>
			}
		</td>
		<td class="py-2 text-right whitespace-nowrap">
			<button
				hx-get={ "/app/services/" + db.UUIDString(svc.ID) + "/edit" }
				hx-target={ "#" + rowID(svc.ID) }
				hx-swap="outerHTML"
				class="mr-2 text-slate-600 underline"
			>
				Edit
			</button>
			<button
				hx-delete={ "/app/services/" + db.UUIDString(svc.ID) }
				hx-vals={ fmt.Sprintf(`{"csrf_token":"%s"}`, csrfToken) }
				hx-target="#services-app"
				hx-swap="outerHTML"
				hx-confirm="Delete this service?"
				class="text-red-600 underline"
			>
				Delete
			</button>
		</td>
	</tr>
}

templ ServiceRowEdit(svc sqlc.Service, csrfToken string) {
	<tr id={ rowID(svc.ID) } class="border-b border-slate-100">
		<td colspan="5" class="py-2">
			<form
				hx-put={ "/app/services/" + db.UUIDString(svc.ID) }
				hx-target={ "#" + rowID(svc.ID) }
				hx-swap="outerHTML"
				class="flex flex-wrap items-center gap-2"
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="text" name="name" value={ svc.Name } required class="rounded-md border border-slate-300 px-2 py-1 text-sm"/>
				<input type="text" name="description" value={ svc.Description } class="rounded-md border border-slate-300 px-2 py-1 text-sm"/>
				<input type="number" name="duration_minutes" value={ fmt.Sprintf("%d", svc.DurationMinutes) } min="1" required class="w-20 rounded-md border border-slate-300 px-2 py-1 text-sm"/>
				<label class="inline-flex items-center gap-1 text-sm">
					<input type="checkbox" name="active" value="true" checked?={ svc.Active }/>
					Active
				</label>
				<button type="submit" class="rounded-md bg-slate-900 px-2 py-1 text-sm font-medium text-white">Save</button>
				<button
					type="button"
					hx-get={ "/app/services/" + db.UUIDString(svc.ID) }
					hx-target={ "#" + rowID(svc.ID) }
					hx-swap="outerHTML"
					class="text-sm text-slate-600 underline"
				>
					Cancel
				</button>
			</form>
		</td>
	</tr>
}

func rowID(id pgtype.UUID) string {
	return "service-row-" + db.UUIDString(id)
}
