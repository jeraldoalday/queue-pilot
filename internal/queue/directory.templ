package queue

import (
	"strconv"

	"github.com/jeraldoalday/queuepilot/internal/db/sqlc"
	"github.com/jeraldoalday/queuepilot/internal/web/components"
)

// linesURL is a business's own front door for walk-ins: every open line,
// shortest wait first.
func linesURL(orgSlug string) string {
	return "/q/" + orgSlug
}

// PublicLinesPage is what somebody standing in a doorway with two lines in
// front of them reads.
//
// It refreshes on the same timer the public board uses. A list of waits
// that was true when the page opened is worse than no list — a customer
// joins the line it recommended and finds it is now the long one.
templ PublicLinesPage(o sqlc.Organization, lines []Line, bookable bool) {
	@components.Layout("Walk in · " + o.Name) {
		<main class="mx-auto max-w-xl px-6 py-12">
			<p class="text-sm text-slate-500">{ o.Name }</p>
			<h1 class="text-2xl font-semibold tracking-tight">Walk in</h1>
			<div
				id="public-lines"
				hx-get={ linesURL(o.Slug) + "/lines" }
				hx-trigger={ publicRefreshInterval }
				hx-swap="innerHTML"
			>
				@PublicLinesBody(o, lines)
			</div>
			if bookable {
				<p class="mt-8 text-center text-sm text-slate-600">
					Would rather come at a set time?
					<a href={ templ.SafeURL("/book/" + o.Slug) } class="font-medium text-slate-900 underline">
						Book an appointment
					</a>
				</p>
			}
		</main>
	}
}

templ PublicLinesBody(o sqlc.Organization, lines []Line) {
	<div>
		if len(lines) == 0 {
			<p class="mt-6 rounded-md bg-slate-100 px-4 py-3 text-sm text-slate-700">
				No lines are open right now.
			</p>
		} else {
			<p class="mt-1 text-sm text-slate-600">
				{ waitingSummary(lines) }
			</p>
			<ul class="mt-6 space-y-3">
				for i, line := range lines {
					<li>
						<a
							href={ templ.SafeURL("/q/" + o.Slug + "/" + line.Queue.Slug) }
							class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400"
						>
							<span>
								<span class="block font-medium">{ line.Queue.Name }</span>
								<span class="block text-sm text-slate-600">
									{ FormatJoinWait(line.Wait) }
									if i == 0 && len(lines) > 1 {
										<span class="ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">shortest</span>
									}
								</span>
							</span>
							<span class="text-right">
								<span class="block text-2xl font-semibold tabular-nums">{ strconv.Itoa(line.Waiting) }</span>
								<span class="block text-xs uppercase tracking-wide text-slate-500">waiting</span>
							</span>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

// waitingSummary words the whole floor in one line, so the page says
// something true before a customer reads any single queue.
func waitingSummary(lines []Line) string {
	total := TotalWaiting(lines)
	switch {
	case total == 0 && len(lines) == 1:
		return "One line, nobody waiting."
	case total == 0:
		return strconv.Itoa(len(lines)) + " lines, nobody waiting."
	case total == 1:
		return "One person waiting."
	default:
		return strconv.Itoa(total) + " people waiting."
	}
}
