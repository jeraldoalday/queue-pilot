package queue

import (
	"strconv"

	"github.com/jeraldoalday/queuepilot/internal/db"
	"github.com/jeraldoalday/queuepilot/internal/web/components"
)

// reportURL is one queue's report for one service day. The date is a
// query parameter rather than a path segment so that "yesterday" and
// "last Tuesday" are the same page with a different argument, and a link
// to a particular day is something someone can paste to a colleague.
func reportURL(queueID, date string) string {
	u := "/app/queues/" + queueID + "/report"
	if date != "" {
		u += "?date=" + date
	}
	return u
}

func consoleURL(queueID string) string {
	return "/app/queues/" + queueID + "/console"
}

templ ReportPage(r Report, prevDate, nextDate, todayDate string) {
	@components.Layout(r.Queue.Name + " · Report") {
		<main class="mx-auto max-w-5xl px-6 py-10">
			<p class="mb-4 space-x-4">
				<a href="/app/queues" class="text-sm text-slate-600 underline">&larr; Queues</a>
				<a href={ templ.SafeURL(consoleURL(db.UUIDString(r.Queue.ID))) } class="text-sm text-slate-600 underline">Console</a>
			</p>

			<h1 class="text-2xl font-semibold tracking-tight">{ r.Queue.Name }</h1>
			<p class="mt-1 text-sm text-slate-600">{ r.Day.Format("Monday, 2 January 2006") }</p>

			@reportDayNav(r, prevDate, nextDate, todayDate)

			if r.Empty() {
				<p class="mt-8 rounded-md border border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-600">
					No tickets were issued on this day.
				</p>
			} else {
				@reportTotals(r)
				@reportTimings(r)
				@reportHistogram(r)
			}

			<p class="mt-8 text-xs text-slate-500">
				Every time here is in this organisation's own timezone, which is
				also the timezone the service day is measured in.
			</p>
		</main>
	}
}

// reportDayNav is how someone actually reaches a report: yesterday, in one
// click, from the day they are looking at. The date field is there for the
// less common "the Tuesday we were short-staffed".
templ reportDayNav(r Report, prevDate, nextDate, todayDate string) {
	<div class="mt-6 flex flex-wrap items-center gap-3 rounded-md border border-slate-200 bg-white px-4 py-3">
		<a
			href={ templ.SafeURL(reportURL(db.UUIDString(r.Queue.ID), prevDate)) }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50"
		>
			&larr; Previous day
		</a>
		<a
			href={ templ.SafeURL(reportURL(db.UUIDString(r.Queue.ID), nextDate)) }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50"
		>
			Next day &rarr;
		</a>
		<a
			href={ templ.SafeURL(reportURL(db.UUIDString(r.Queue.ID), "")) }
			class="text-sm text-slate-600 underline"
		>
			Today
		</a>
		<form method="GET" action={ templ.SafeURL(reportURL(db.UUIDString(r.Queue.ID), "")) } class="ml-auto flex items-center gap-2">
			<label for="date" class="text-xs text-slate-600">Jump to</label>
			<input
				id="date"
				name="date"
				type="date"
				value={ r.Day.Format(dateLayout) }
				max={ todayDate }
				class="rounded-md border border-slate-300 px-2 py-1.5 text-sm"
			/>
			<button type="submit" class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700">
				Go
			</button>
		</form>
	</div>
}

templ reportTotals(r Report) {
	<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
		@statTile("Tickets issued", r.Issued())
		@statTile("Served", r.Stats.Done)
		@statTile("No-shows", r.Stats.NoShow)
		@statTile("Cancelled", r.Stats.Cancelled)
	</div>
	<div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
		@rateTile("Served through", r.CompletionPercent, r.Resolved())
		@rateTile("No-show rate", r.NoShowPercent, r.Resolved())
	</div>
	if r.Stats.Open() > 0 {
		<p class="mt-3 text-xs text-slate-500">
			{ strconv.Itoa(r.Stats.Open()) } { plural(r.Stats.Open(), "ticket is", "tickets are") } still open, so the
			rates above are over the { strconv.Itoa(r.Resolved()) } that have finished.
		</p>
	}
}

// rateTile renders a percentage that may not exist yet. A queue with
// nothing resolved has no rate, and printing "0%" for that would read as
// a perfect record rather than as an absence of information.
templ rateTile(label string, rate func() (int, bool), resolved int) {
	<div class="rounded-md border border-slate-200 bg-white p-4">
		<p class="text-xs uppercase tracking-wide text-slate-500">{ label }</p>
		if pct, ok := rate(); ok {
			<p class="mt-1 text-2xl font-semibold">{ strconv.Itoa(pct) }%</p>
			<p class="mt-1 text-xs text-slate-500">of { strconv.Itoa(resolved) } finished { plural(resolved, "ticket", "tickets") }</p>
		} else {
			<p class="mt-1 text-2xl font-semibold text-slate-300">—</p>
			<p class="mt-1 text-xs text-slate-500">nothing has finished yet</p>
		}
	</div>
}

templ reportTimings(r Report) {
	<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
		@durationCard("Wait before being called", r.Wait)
		@durationCard("Time at the counter", r.Service)
	</div>
}

// durationCard shows the average with its extremes, because an average
// alone hides the day that ran fine except for the one person who waited
// an hour — which is exactly the day someone opens this page to find.
templ durationCard(label string, d DurationSummary) {
	<div class="rounded-md border border-slate-200 bg-white p-4">
		<p class="text-xs uppercase tracking-wide text-slate-500">{ label }</p>
		if d.Empty() {
			<p class="mt-1 text-2xl font-semibold text-slate-300">—</p>
			<p class="mt-1 text-xs text-slate-500">nothing measurable on this day</p>
		} else {
			<p class="mt-1 text-2xl font-semibold tabular-nums">{ FormatDuration(d.Mean()) }</p>
			<p class="mt-1 text-xs text-slate-500">
				average of { strconv.Itoa(d.Count) } { plural(d.Count, "ticket", "tickets") } ·
				quickest { FormatDuration(d.Min) } · longest { FormatDuration(d.Max) }
			</p>
		}
	</div>
}

// reportHistogram is drawn with plain sized divs rather than a chart
// library: the app ships no JavaScript beyond htmx, and a bar whose width
// is a percentage is the whole of what this needs.
templ reportHistogram(r Report) {
	<section class="mt-6 rounded-md border border-slate-200 bg-white p-4">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="text-base font-medium">When the tickets came</h2>
			if peak, ok := r.PeakHour(); ok {
				<p class="text-xs text-slate-500">
					Busiest: { peak.Label() } with { strconv.Itoa(peak.Issued) } { plural(peak.Issued, "ticket", "tickets") }
				</p>
			}
		</div>
		<ul class="mt-4 space-y-1.5">
			for _, h := range r.Hours {
				<li class="flex items-center gap-3">
					<span class="w-28 shrink-0 text-xs tabular-nums text-slate-500">{ h.Label() }</span>
					<span class="h-4 flex-1 overflow-hidden rounded-sm bg-slate-100">
						<span class="block h-full rounded-sm bg-slate-900" style={ barWidth(h.Share(r.PeakIssued())) }></span>
					</span>
					<span class="w-8 shrink-0 text-right text-xs tabular-nums text-slate-600">{ strconv.Itoa(h.Issued) }</span>
				</li>
			}
		</ul>
	</section>
}
