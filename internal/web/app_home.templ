package web

import (
	"github.com/jeraldoalday/queuepilot/internal/session"
	"github.com/jeraldoalday/queuepilot/internal/web/components"
)

templ AppHome(ident session.Identity) {
	@components.Layout("Dashboard") {
		<main class="mx-auto max-w-2xl px-6 py-16">
			<h1 class="text-2xl font-semibold tracking-tight">Welcome, { ident.Name }</h1>
			<p class="mt-2 text-sm text-slate-600">
				Signed in as { ident.Email } · role: { string(ident.Role) }
			</p>
			<form method="POST" action="/logout" class="mt-8">
				<button type="submit" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
					Log out
				</button>
			</form>
		</main>
	}
}
