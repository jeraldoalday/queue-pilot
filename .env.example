# Copy to .env and adjust as needed for local development.
# docker-compose reads this file automatically.

ENV=development
PORT=8080

# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://queuepilot:queuepilot@localhost:5432/queuepilot?sslmode=disable

POSTGRES_USER=queuepilot
POSTGRES_PASSWORD=queuepilot
POSTGRES_DB=queuepilot
