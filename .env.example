# Copy to .env and adjust as needed for local development.

ENV=development
PORT=8080

# Set to "true" ONLY when the app runs behind a proxy that overwrites
# X-Forwarded-For (Fly.io, a load balancer, nginx). It controls whether
# that header is believed when identifying a client for rate limiting.
# On a directly-exposed server, trusting it lets any client set its own
# identity and bypass the limit entirely, so it defaults to false.
TRUST_PROXY_HEADERS=false

# Gates /metrics, and turns it on at all. Leave it unset (the default) and
# the endpoint answers 404 to everyone, including whoever knows the path:
# a scrape describes every tenant's day at once — how many people took a
# number, when the rush was — which is not something to serve to anybody
# who asks. Set it to a long random string and scrape with
#   Authorization: Bearer <token>
# METRICS_TOKEN=

# Option A (default here): a hosted Supabase Postgres. Get this from
# Project Settings -> Database -> Connection string (URI), session-mode
# pooler on port 5432 -- not the 6543 transaction-mode pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: local Postgres via docker-compose (`docker compose up -d db`).
# If using this instead, set DATABASE_URL to:
#   postgres://queuepilot:queuepilot@localhost:5432/queuepilot?sslmode=disable
# docker-compose.yml reads these to configure that container.
POSTGRES_USER=queuepilot
POSTGRES_PASSWORD=queuepilot
POSTGRES_DB=queuepilot
